{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build:web && pnpm build:server",
  "devCommand": "pnpm exec vite --port $PORT --strictPort",
  "outputDirectory": "dist",
  "env": {
    "AGENT_TASK_LOOP_V1": "false"
  },
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
