# Browser origin allowed to perform authenticated mutations.
APP_ORIGIN=http://127.0.0.1:5173
PUBLIC_VIEWER_ORIGIN=http://view.localhost:5174
PORT=8787

# Authenticated-app build. Published links always leave the app origin.
VITE_PUBLIC_VIEWER_ORIGIN=http://view.localhost:5174

# Public-viewer build only. Point this at the authenticated app/API origin so
# published pages never send the viewer origin's cookies to the API.
VITE_PUBLIC_API_ORIGIN=http://127.0.0.1:5173

# Supabase project values. The publishable key is safe to identify the project,
# but this server still keeps all auth tokens in HttpOnly cookies.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Do not add a service-role/secret key or the thumbnail cleanup Cron secret to
# this Vercel environment. Supabase hosts that worker and injects its own
# service-role credential; see docs/thumbnail-storage-lifecycle.md.

# Vercel/serverless runtime URL: use Supavisor shared transaction mode (port
# 6543). Shared-pooler usernames must be role.PROJECT_REF.
DATABASE_URL=postgresql://easy_dashboard_runtime.PROJECT_REF:replace_me@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# M0 isolated Document Executor only. Generate at least 32 random bytes and
# keep the value in the Hono/runner environment; never inject it into a page.
# AGENT_EXECUTOR_GRANT_SECRET=
# Supply this strict JSON tuple from the release artifact lock. Do not copy
# workspace-local hashes into deployment configuration by hand.
# AGENT_EXECUTOR_COMPATIBILITY_JSON=
# Local/private runner process and immutable browser Host artifact. The API
# origin must be reachable by the runner and should normally remain loopback.
# AGENT_EXECUTOR_CLI_PATH=/absolute/path/to/EasyEditor/spikes/document-executor/src/cli.mjs
# AGENT_EXECUTOR_DASHBOARD_URL=http://127.0.0.1:4173/index.html
# AGENT_EXECUTOR_API_ORIGIN=http://127.0.0.1:5173
# AGENT_EXECUTOR_TIMEOUT_MS=120000
# Conservative upper bound used for BYOK/relay budget reservation when the
# provider does not expose authoritative pricing metadata.
# AGENT_BILLING_MAX_USD_PER_1M_TOKENS=100

# Authenticated Agent planning relay. Keep the key server-only. The local
# server also reads .env.local after .env so developers can keep these values
# out of the shared environment file.
# EASY_EDITOR_AGENT_BASE_URL=https://relay.example.com/v1
# EASY_EDITOR_AGENT_API_KEY=
# EASY_EDITOR_AGENT_MODEL=gpt-4.1
# Agent planning defaults to 120 seconds. Optional override: 5000..600000 ms.
# AGENT_MODEL_TIMEOUT_MS=120000
# Local development only: expose PieChart 0.0.8 display styles to the Agent
# when the matching linked browser material is enabled. Keep disabled in normal
# deployments pinned to the published 0.0.7 material.
# AGENT_ENABLE_LINKED_PIE_CHART_0_0_8=false

# Encrypts user-configured model API keys stored in Settings JSON. Generate 32
# random bytes and encode them as base64; keep this server-only and stable.
# AGENT_MODEL_PROFILE_ENCRYPTION_KEY=

# Migrations must use a direct/session-mode connection, never DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:replace_me@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
